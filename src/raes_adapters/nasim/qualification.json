  "known_defects": [
    {
      "id": "supplied-agents-numpy-int-incompatibility-gymnasium-ge-0.27",
      "status": "observed-in-selected-source",
      "impact": "FlatActionSpace.get_action asserts isinstance(action_idx, int) (nasim/envs/action.py:698); gymnasium >= 0.27 returns numpy.int64 from Discrete.n and Discrete.sample(), so the supplied bruteforce and random agents, and the greedy paths of ql/dqn, raise AssertionError. The qualified runtime pins gymnasium 0.26.3, the last release where Discrete.n is a Python int."
    },
    {
      "id": "action-success-rng-unbound-by-env-seed",
      "status": "observed-in-selected-source",
      "impact": "Action success is drawn from the global numpy RNG (network.py:87), not the gym-seeded self.np_random; make_benchmark(seed) and reset(seed) do not make a run reproducible. Only an explicit numpy.random.seed() binds it."
    },
    {
      "id": "static-benchmark-seed-ignored",
      "status": "observed-in-selected-source",
      "impact": "make_benchmark_scenario loads static YAML benchmarks via load_scenario and ignores the seed argument entirely (scenarios/__init__.py); the seed only affects generated benchmarks."
    },
    {
      "id": "headless-import-requires-tkinter",
      "status": "observed-in-selected-source",
      "impact": "nasim/envs/render.py unconditionally imports tkinter and calls matplotlib.use('TkAgg') at import time (pulled in by environment.py), so 'import nasim' fails without the Tk system libraries even for headless/programmatic use."
    }
  ],
  "packaging": {
    "repository_extra": "nasim",
    "extra_declaration": [
      "nasim==0.12.0",
      "gymnasium==0.26.3",
      "numpy==1.26.4",
      "raes-env-packs==3.6.2"
    ],
    "publishable_distribution": true,
    "base_cyborg_cyberbattlesim_unchanged": true,
    "conflicts_declaration_required": false,
    "decision": "NASim publishes an index distribution (wheel + sdist for 0.12.0), so the nasim extra pins nasim==0.12.0 directly (unlike cyberbattlesim, whose source is unpublished). It also pins the qualified gymnasium 0.26.3 / numpy 1.26.4 runtime so that installing raes-adapters[nasim] reproduces the admitted, runnable protocol instead of a later gymnasium that breaks NASim's supplied agents. The extra additionally pins raes-env-packs==3.6.2 (as the cyborg extra does) so a clean raes-adapters[nasim] install can validate and run the packaged nasim-tiny environment pack through the researcher command; the pack validator is tooling and does not alter the qualified simulator runtime.",
    "reason": "The single uv.lock holds no gymnasium/numpy/matplotlib/networkx outside this extra and no other extra constrains them, so nasim resolves independently to the pinned runtime and no uv conflicts declaration is required. raes_adapters.nasim imports none of the simulator stack, so the repository test and typecheck graph never imports NASim."
  },
